{
  "name": "netwatch",
  "version": "5.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:shortcuts && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/unit/*.test.ts\"",
    "test:shortcuts": "node tests/browser/shortcuts-core.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "selftest": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/selftest.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.453.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
